            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff One Updated\",\n  \"role\": \"VIEWER\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
