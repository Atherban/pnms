            ],
            "url": "{{baseUrl}}/api/seeds",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato Seed\",\n  \"supplierName\": \"Agro Corp\",\n  \"totalPurchased\": 1000,\n  \"purchaseDate\": \"2026-01-01\",\n  \"expiryDate\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Get Seeds",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/seeds"
          }
        },
        {
          "name": "Get Seed By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/seeds/{{seedId}}"
          }
        },
        {
          "name": "Update Seed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/seeds/{{seedId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"Updated Supplier\"\n}"
            }
          }
        },
        {
          "name": "Delete Seed",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/seeds/{{seedId}}"
          }
        }
      ]
    },
    {
      "name": "Sowing",
      "item": [
        {
          "name": "Sow Seeds",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sowing",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seedId\": \"{{seedId}}\",\n  \"plantId\": \"{{plantId}}\",\n  \"quantity\": 100\n}"
            }
          }
        },
        {
          "name": "Get Sowings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sowing"
          }
        }
      ]
    },
    {
      "name": "Germination",
      "item": [
        {
          "name": "Record Germination",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/germination",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sowingId\": \"{{sowingId}}\",\n  \"germinatedSeeds\": 80\n}"
            }
          }
        },
        {
          "name": "Get Germinations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/germination"
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sales",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"plantId\": \"{{plantId}}\", \"quantity\": 2 }],\n  \"paymentMode\": \"CASH\"\n}"
            }
          }
        },
        {
          "name": "Get Sales",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sales"
          }
        },
        {
          "name": "Get Sale By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sales/{{saleId}}"
          }
        }
      ]
    },
    {
      "name": "Profit",
      "item": [
        {
          "name": "Get Profit",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/profit?startDate=2026-01-01&endDate=2026-12-31"
          }
        }
      ]
    }
  ]
}
