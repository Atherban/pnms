{
  "info": {
    "name": "PNMS - Complete API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete production-grade API testing collection for Plant Nursery Management System"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Plants",
      "item": [
        {
          "name": "Create Plant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/plants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rose\",\n  \"category\": \"FLOWER\",\n  \"price\": 120,\n  \"quantityAvailable\": 50\n}"
            }
          }
        },
        {
          "name": "Get All Plants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plants"
          }
        },
        {
          "name": "Get Plant By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plants/{{plantId}}"
          }
        },
        {
          "name": "Update Plant",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/plants/{{plantId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 150\n}"
            }
          }
        },
        {
          "name": "Delete Plant",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/plants/{{plantId}}"
          }
        },
        {
          "name": "Upload Plant Image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/uploads/plants/{{plantId}}/image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Seeds",
      "item": [
        {
          "name": "Create Seed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/seeds",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato Seed\",\n  \"category\": \"VEGETABLE\",\n  \"supplierName\": \"Agro Seeds\",\n  \"totalPurchased\": 1000,\n  \"purchaseDate\": \"2026-01-01\",\n  \"expiryDate\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Get All Seeds",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/seeds"
          }
        },
        {
          "name": "Get Seed By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/seeds/{{seedId}}"
          }
        },
        {
          "name": "Update Seed",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/seeds/{{seedId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"Updated Supplier\"\n}"
            }
          }
        },
        {
          "name": "Delete Seed",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/seeds/{{seedId}}"
          }
        },
        {
          "name": "Upload Seed Image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/seeds/{{seedId}}/image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale (Transactional)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/sales",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plantId\": \"{{plantId}}\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Get All Sales",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sales"
          }
        }
      ]
    },
    {
      "name": "Profit",
      "item": [
        {
          "name": "Get Profit Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profit"
          }
        }
      ]
    }
  ]
}
