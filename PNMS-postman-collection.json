{
  "info": {
    "name": "PNMS - Backend API (Domain-Correct)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "PNMS backend aligned with PlantType + Inventory domain model"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "plantTypeId", "value": "" },
    { "key": "seedId", "value": "" },
    { "key": "sowingId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "saleId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "PlantTypes",
      "item": [
        {
          "name": "Create PlantType",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/plant-types",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato\",\n  \"category\": \"VEGETABLE\"\n}"
            }
          }
        },
        {
          "name": "Upload PlantType Image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/plant-types/{{plantTypeId}}/image",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file" }] }
          }
        },
        {
          "name": "Get PlantTypes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plant-types",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Seeds",
      "item": [
        {
          "name": "Create Seed",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/seeds",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato Seed Batch\",\n  \"plantType\": \"{{plantTypeId}}\",\n  \"supplierName\": \"Agro Corp\",\n  \"totalPurchased\": 1000,\n  \"purchaseDate\": \"2026-01-01\",\n  \"expiryDate\": \"2026-12-31\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Sowing",
      "item": [
        {
          "name": "Sow Seeds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sowing",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seedId\": \"{{seedId}}\",\n  \"quantity\": 100\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/inventory",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"inventoryId\": \"{{inventoryId}}\", \"quantity\": 2 }],\n  \"paymentMode\": \"CASH\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Profit",
      "item": [
        {
          "name": "Get Profit",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profit?startDate=2026-01-01&endDate=2026-12-31",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
