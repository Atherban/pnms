{
  "info": {
    "name": "PNMS - Backend API (Full Refactor)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete PNMS API collection with auth, master, operations, analytics and CRUD endpoints."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "plantTypeId", "value": "" },
    { "key": "seedId", "value": "" },
    { "key": "sowingId", "value": "" },
    { "key": "germinationId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "saleId", "value": "" },
    { "key": "expenseId", "value": "" },
