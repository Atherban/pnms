{
  "info": {
    "name": "PNMS - Final API Collection (Auth + RBAC)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete, production-grade API collection for PNMS backend"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (ADMIN / STAFF)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Plants",
      "item": [
        {
          "name": "Create Plant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/plants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rose\",\n  \"category\": \"FLOWER\",\n  \"price\": 150,\n  \"quantityAvailable\": 50\n}"
            }
          }
        },
        {
          "name": "Get All Plants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/plants"
          }
        },
        {
          "name": "Get Plant By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/plants/{{plantId}}"
          }
        },
        {
          "name": "Update Plant Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/plants/{{plantId}}/quantity",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChange\": 40\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Seeds",
      "item": [
        {
          "name": "Create Seed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/seeds",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato Seed\",\n  \"category\": \"VEGETABLE\",\n  \"supplierName\": \"Agro Corp\",\n  \"totalPurchased\": 1000,\n  \"purchaseDate\": \"2026-01-01\",\n  \"expiryDate\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Get All Seeds",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/seeds"
          }
        }
      ]
    },
    {
      "name": "Sowing",
      "item": [
        {
          "name": "Sow Seeds",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sowing",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seedId\": \"{{seedId}}\",\n  \"plantId\": \"{{plantId}}\",\n  \"quantity\": 100\n}"
            }
          }
        },
        {
          "name": "Get All Sowings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sowing"
          }
        }
      ]
    },
    {
      "name": "Germination",
      "item": [
        {
          "name": "Record Germination",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/germination",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sowingId\": \"{{sowingId}}\",\n  \"germinatedSeeds\": 80\n}"
            }
          }
        },
        {
          "name": "Get All Germinations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/germination"
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sales",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"plantId\": \"{{plantId}}\", \"quantity\": 2 }\n  ],\n  \"paymentMode\": \"CASH\"\n}"
            }
          }
        },
        {
          "name": "Get All Sales",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sales"
          }
        }
      ]
    },
    {
      "name": "Profit",
      "item": [
        {
          "name": "Get Profit (Date Range)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/profit?startDate=2026-01-01&endDate=2026-12-31"
          }
        }
      ]
    }
  ]
}
